# CLASS_FUND_WEB - Production Ingress Proxy Dockerfile
# Multi-arch compatible: linux/amd64 and linux/arm64
FROM caddy:2.8-alpine

LABEL maintainer="CLASS_FUND_WEB SRE Team"
LABEL description="Production Edge Ingress Proxy with automated TLS and WSS"

COPY docker/proxy/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O - http://127.0.0.1:80/api/v1/health || exit 1

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]

# Class Fund Backend - Environment Variables
# Copy to .env and fill in values

# Application
APP_NAME="Class Fund API"
ENVIRONMENT=development

# Database (MySQL 8.4 LTS)
DATABASE_URL=mysql+pymysql://classfund:classfund@127.0.0.1:3306/classfund?charset=utf8mb4

# MySQL Primary/Replica Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_PASSWORD=classfund
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_REPLICATION_USER=repl_user
MYSQL_REPLICATION_PASSWORD=repl_password

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60

# File Upload
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10

# AI Service (Internal API key for vision endpoint)
AI_SERVICE_KEY=your-ai-service-key-change-in-production

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Confidence Threshold (0.0-1.0)
AI_CONFIDENCE_THRESHOLD=0.90

# Ollama Configuration
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TEXT_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_DELAY=2.0

# Worker Configuration
WORKER_ID=worker-1
LEASE_DURATION=300

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=redis_password

# Logging
LOG_LEVEL=INFO

# SSL/TLS Configuration (MySQL)
# For production, use proper certificates from a CA
# MYSQL_SSL_CA=/path/to/ca.pem
# MYSQL_SSL_CERT=/path/to/client-cert.pem
# MYSQL_SSL_KEY=/path/to/client-key.pem

# Redis TLS (if using Redis with TLS)
# REDIS_TLS_CA=/path/to/redis-ca.pem
# Class Fund Backend - Environment Variables
# Copy to .env and fill in values

# Application
APP_NAME="Class Fund API"
ENVIRONMENT=development

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://classfund:classfund@localhost:5432/classfund

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60

# File Upload
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10

# AI Service (Internal API key for vision endpoint)
AI_SERVICE_KEY=your-ai-service-key-change-in-production

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Confidence Threshold (0.0-1.0)
AI_CONFIDENCE_THRESHOLD=0.90

# Ollama Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TEXT_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_DELAY=2.0

# Supabase Configuration (Required for Realtime and Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Worker Configuration
WORKER_ID=worker-1
LEASE_DURATION=300

# Logging
LOG_LEVEL=INFO
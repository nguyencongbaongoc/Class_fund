# ==============================================================================
# CLASS_FUND_WEB - Production Environment Configuration Template
# Instructions: Copy to .env.production and provide cryptographically secure secrets.
# ==============================================================================

# Application & Environment
ENVIRONMENT=production
DOMAIN=fund.example.com
ACME_EMAIL=security@example.com
TLS_MODE=internal # In public prod with real domain: set to your domain or Let's Encrypt / acme
CORS_ORIGINS=https://fund.example.com,https://admin.fund.example.com

# Container Registry & Versioning
DOCKER_REGISTRY=classfund
VERSION=0.1.0-prod

# Database Credentials (MySQL 8.4 Cluster)
MYSQL_DATABASE=classfund
MYSQL_USER=classfund
MYSQL_PASSWORD=GENERATE_SECURE_MYSQL_PASSWORD_HERE
MYSQL_ROOT_PASSWORD=GENERATE_SECURE_ROOT_PASSWORD_HERE
MYSQL_REPL_USER=repl_user
MYSQL_REPL_PASSWORD=GENERATE_SECURE_REPL_PASSWORD_HERE
MYSQL_PRIMARY_HOST=mysql-primary
MYSQL_PRIMARY_PORT=3306
MYSQL_REPLICA_HOST=mysql-replica
MYSQL_REPLICA_PORT=3306
MYSQL_SSL_MODE=REQUIRED

# Database Connection URLs (Internal Service Mesh)
DATABASE_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql-primary:3306/${MYSQL_DATABASE}?charset=utf8mb4
DATABASE_URL_REPLICA=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql-replica:3306/${MYSQL_DATABASE}?charset=utf8mb4

# Redis In-Memory Broker & Cache
REDIS_PASSWORD=GENERATE_SECURE_REDIS_PASSWORD_HERE
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Security, Tokens & Hashes (Argon2id + HS256 JWT)
JWT_SECRET=GENERATE_STRONG_SECRET_AT_LEAST_64_CHARACTERS_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# File Upload & Storage Policy
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_MB=10

# Financial Core Invariants
AI_CONFIDENCE_THRESHOLD=0.90
DECIMAL_PRECISION=2
REPLICATION_LAG_THRESHOLD_SECONDS=5.0

# Worker Service Configuration
WORKER_ID=worker-prod-1
LEASE_DURATION=300

# Ollama Vision & Text Models
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TEXT_MODEL=qwen3.5:4b

# Observability & Monitoring
METRICS_ENABLED=true
LOG_FORMAT=json
FAILOVER_CHECK_INTERVAL=3.0
FAILOVER_FAILURE_THRESHOLD=3

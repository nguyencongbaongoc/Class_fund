# Class Fund Frontend - Environment Variables
# Copy to .env and fill in values

# API Backend URL
VITE_API_URL=http://localhost:8000/api/v1

# Supabase Configuration (Required for Realtime)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Feature Flags
VITE_ENABLE_REALTIME=true
VITE_ENABLE_POLLING_FALLBACK=true
VITE_POLLING_INTERVAL_MS=5000

# Upload Configuration
VITE_MAX_FILE_SIZE_MB=5
VITE_MAX_IMAGES_PER_MESSAGE=5
VITE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# UI Configuration
VITE_APP_NAME=Class Fund
VITE_DEFAULT_CONVERSATION_ID=classfund_main